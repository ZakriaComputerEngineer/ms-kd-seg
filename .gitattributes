# The notebook is generated by scripts/build_notebook.py and committed without
# outputs or execution counts, so its diffs are meaningful. Marking it as text
# keeps line-ending normalisation consistent across platforms; without this a
# Windows checkout rewrites every line and CI's "notebook is in sync" check fails
# on line endings alone.
*.ipynb text eol=lf

# Source and docs
*.py     text eol=lf
*.md     text eol=lf
*.tex    text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.cff    text eol=lf
*.txt    text eol=lf

# Never normalise these
*.png    binary
*.pdf    binary
*.pt     binary
*.nii    binary
*.nii.gz binary

# Treat the generated notebook as generated in GitHub's language stats and
# collapse it by default in pull request diffs.
notebooks/*.ipynb linguist-generated=true
